# ── LLM для физ. параметров (масса, трение, размер) ─────────────────
# ollama    — локальная модель (рекомендуется)
# qwen2.5-vl — OpenRouter (бесплатно)
# gpt-4o    — Azure OpenAI
GPT_AGENT_TYPE=ollama

# Модель в Ollama (должна быть запущена: ollama run qwen3.5:cloud)
MODEL_NAME=qwen3.5:cloud

# ── Text-to-image модель ─────────────────────────────────────────────
# sdxl-turbo — для 8GB GPU (RTX 2070 Super)
# sd35       — для 10GB+ GPU
TEXT_MODEL=sdxl-turbo
