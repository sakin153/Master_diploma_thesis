# ── LLM для физ. параметров (масса, трение, размер) ─────────────────
# ollama    — локальная модель (рекомендуется)
# qwen2.5-vl — OpenRouter (бесплатно)
# gpt-4o    — Azure OpenAI
GPT_AGENT_TYPE=ollama

# Модель в Ollama (должна быть запущена: ollama run qwen3.5:cloud)
MODEL_NAME=qwen3.5:cloud

# ── Text-to-image модель ─────────────────────────────────────────────
# sdxl-turbo — для 8GB GPU (RTX 2070 Super)
# sd35       — для 10GB+ GPU
TEXT_MODEL=sdxl-turbo

# ── Hunyuan3D texture pipeline ───────────────────────────────────────
# 1 — включить (нужно ~6 GB VRAM, последовательно после shape)
# 0 — выключить (быстрее, только геометрия)
HUNYUAN3D_TEXTURE=0

# ── Кэши моделей (bind mounts для Docker) ────────────────────────────
# Позволяет переиспользовать уже скачанные модели между Docker и локальным запуском.
# По умолчанию — папка weights/ в корне проекта.
# Укажи свой путь если модели уже есть в другом месте.
#
# Linux / macOS:
# HF_CACHE_HOST=~/.cache/huggingface
# HY3DGEN_CACHE_HOST=~/.cache/hy3dgen
# TORCH_CACHE_HOST=~/.cache/torch
#
# Windows (Docker Desktop):
# HF_CACHE_HOST=C:/Users/ИМЯ/.cache/huggingface
# HY3DGEN_CACHE_HOST=C:/Users/ИМЯ/.cache/hy3dgen
# TORCH_CACHE_HOST=C:/Users/ИМЯ/.cache/torch
#
HF_CACHE_HOST=./weights/hf_cache
HY3DGEN_CACHE_HOST=./weights/hy3dgen
TORCH_CACHE_HOST=./weights/torch_cache
U2NET_CACHE_HOST=./weights/u2net
