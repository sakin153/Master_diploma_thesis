digraph SceneGraph {
  graph [rankdir=LR, fontsize=12, fontname="Helvetica", labelloc=t, pad=0.2];
  node [shape=box, style="rounded,filled", color="#455a64", penwidth=1.1, fontname="Helvetica", fontsize=10];
  edge [color="#546e7a", penwidth=1.0, arrowsize=0.7, fontname="Helvetica", fontsize=9];
  label="Scene Graph: Большой стол, на нем один ящик, а в ящике яблоки разного цвета.. This is a other scene with coherent furnishing. Suggested objects: . Arrange objects with realistic spacing and circulation.";
  "obj_0" [label="S E Asian Table\n(obj_0)\nconstraints=1", fillcolor="#f5eef8"];
  "obj_1" [label="2 Containers100X100\n(obj_1)\nconstraints=2", fillcolor="#d5f5e3"];
  "obj_2" [label="Delicious Red Apple\n(obj_2)\nconstraints=2", fillcolor="#f5eef8"];
  "obj_3" [label="Emmmanuel Diaz Apple\n(obj_3)\nconstraints=1", fillcolor="#d6eaf8"];
  "virtual_1" [shape=note, fillcolor="#eceff1", label="region | w=1.00 | v=middle", color="#90a4ae"];
  "obj_0" -> "virtual_1" [style="dashed", color="#78909c"];
  "obj_1" -> "obj_0" [label="on_top_of | w=1.00", style="dashed"];
  "obj_1" -> "obj_0" [label="near | w=0.80 | d=[0.2, 0.5]", style="dashed"];
  "obj_2" -> "obj_1" [label="on_top_of | w=1.00", style="dashed"];
  "obj_2" -> "obj_3" [label="near | w=0.70 | d=[0.05, 0.2]", style="dashed"];
  "obj_3" -> "obj_1" [label="on_top_of | w=1.00", style="dashed"];
}
