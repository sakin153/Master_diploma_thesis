digraph SceneGraph {
  graph [rankdir=LR, fontsize=12, fontname="Helvetica", labelloc=t, pad=0.2];
  node [shape=box, style="rounded,filled", color="#455a64", penwidth=1.1, fontname="Helvetica", fontsize=10];
  edge [color="#546e7a", penwidth=1.0, arrowsize=0.7, fontname="Helvetica", fontsize=9];
  label="Scene Graph: офисный кабинет с 4 столами и 8 стульями и компьютеры на каждом столе";
  "obj_0" [label="Computer\n(obj_0)\nconstraints=1", fillcolor="#d6eaf8"];
  "obj_1" [label="Computer\n(obj_1)\nconstraints=2", fillcolor="#d6eaf8"];
  "obj_2" [label="Computer\n(obj_2)\nconstraints=2", fillcolor="#d6eaf8"];
  "obj_3" [label="Computer\n(obj_3)\nconstraints=2", fillcolor="#d6eaf8"];
  "obj_4" [label="Chair\n(obj_4)\nconstraints=2", fillcolor="#f9ebea"];
  "obj_5" [label="Chair\n(obj_5)\nconstraints=2", fillcolor="#f9ebea"];
  "obj_6" [label="Chair\n(obj_6)\nconstraints=2", fillcolor="#f9ebea"];
  "obj_7" [label="Chair\n(obj_7)\nconstraints=2", fillcolor="#f9ebea"];
  "obj_8" [label="Chair\n(obj_8)\nconstraints=2", fillcolor="#f9ebea"];
  "obj_9" [label="Chair\n(obj_9)\nconstraints=2", fillcolor="#f9ebea"];
  "obj_10" [label="Chair\n(obj_10)\nconstraints=2", fillcolor="#f9ebea"];
  "obj_11" [label="Chair\n(obj_11)\nconstraints=2", fillcolor="#f9ebea"];
  "obj_12" [label="Chair\n(obj_12)\nconstraints=2", fillcolor="#f9ebea"];
  "virtual_1" [shape=note, fillcolor="#eceff1", label="region | w=1.00 | v=middle", color="#90a4ae"];
  "obj_0" -> "virtual_1" [style="dashed", color="#78909c"];
  "virtual_2" [shape=note, fillcolor="#eceff1", label="region | w=1.00 | v=middle", color="#90a4ae"];
  "obj_1" -> "virtual_2" [style="dashed", color="#78909c"];
  "obj_1" -> "obj_0" [label="right_of | w=0.60", style="dashed"];
  "virtual_3" [shape=note, fillcolor="#eceff1", label="region | w=1.00 | v=middle", color="#90a4ae"];
  "obj_2" -> "virtual_3" [style="dashed", color="#78909c"];
  "obj_2" -> "obj_1" [label="right_of | w=0.60", style="dashed"];
  "virtual_4" [shape=note, fillcolor="#eceff1", label="region | w=1.00 | v=middle", color="#90a4ae"];
  "obj_3" -> "virtual_4" [style="dashed", color="#78909c"];
  "obj_3" -> "obj_2" [label="right_of | w=0.60", style="dashed"];
  "obj_4" -> "obj_3" [label="near | w=0.80 | d=[0.4, 0.9]", style="dashed"];
  "obj_4" -> "obj_0" [label="in_front_of | w=0.50", style="dashed"];
  "obj_5" -> "obj_1" [label="near | w=0.80 | d=[0.4, 0.9]", style="dashed"];
  "obj_5" -> "obj_2" [label="in_front_of | w=0.50", style="dashed"];
  "obj_6" -> "obj_3" [label="near | w=0.80 | d=[0.4, 0.9]", style="dashed"];
  "obj_6" -> "obj_0" [label="in_front_of | w=0.50", style="dashed"];
  "obj_7" -> "obj_1" [label="near | w=0.80 | d=[0.4, 0.9]", style="dashed"];
  "obj_7" -> "obj_2" [label="in_front_of | w=0.50", style="dashed"];
  "obj_8" -> "obj_3" [label="near | w=0.80 | d=[0.4, 0.9]", style="dashed"];
  "obj_8" -> "obj_0" [label="in_front_of | w=0.50", style="dashed"];
  "obj_9" -> "obj_1" [label="near | w=0.80 | d=[0.4, 0.9]", style="dashed"];
  "obj_9" -> "obj_2" [label="in_front_of | w=0.50", style="dashed"];
  "obj_10" -> "obj_3" [label="near | w=0.80 | d=[0.4, 0.9]", style="dashed"];
  "obj_10" -> "obj_0" [label="in_front_of | w=0.50", style="dashed"];
  "obj_11" -> "obj_1" [label="near | w=0.80 | d=[0.4, 0.9]", style="dashed"];
  "obj_11" -> "obj_2" [label="in_front_of | w=0.50", style="dashed"];
  "obj_12" -> "obj_3" [label="near | w=0.80 | d=[0.4, 0.9]", style="dashed"];
  "obj_12" -> "obj_0" [label="in_front_of | w=0.50", style="dashed"];
}
