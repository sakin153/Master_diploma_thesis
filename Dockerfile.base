# ─────────────────────────────────────────────────────────────────────
# Базовый образ — собирается ОДИН РАЗ.
# Пересобирать только при изменении зависимостей.
#
#   docker build -f Dockerfile.base -t embodiedgen-base:latest .
# ─────────────────────────────────────────────────────────────────────
# syntax=docker/dockerfile:1
FROM pytorch/pytorch:2.4.0-cuda11.8-cudnn9-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential ninja-build curl \
    libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV CUDA_HOME=/usr/local/cuda-11.8 \
    PATH=/usr/local/cuda-11.8/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda-11.8/lib64:$LD_LIBRARY_PATH \
    DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6" \
    TCNN_CUDA_ARCHITECTURES=75,80,86 \
    TOKENIZERS_PARALLELISM=false \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ── 1. xformers (torch уже есть в базовом образе) ────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip==22.3.1 && \
    pip install \
        xformers==0.0.27.post2 \
        --index-url https://download.pytorch.org/whl/cu118

# ── 2. requirements.txt ──────────────────────────────────────────────
COPY requirements.txt /tmp/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /tmp/requirements.txt --use-deprecated=legacy-resolver

# ── 3. Лёгкие git-пакеты (без компиляции, по одному во избежание конфликтов) ──
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps "utils3d@git+https://github.com/EasternJournalist/utils3d.git@9a4eb15"
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "clip@git+https://github.com/openai/CLIP.git"
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "segment-anything@git+https://github.com/facebookresearch/segment-anything.git@dca509f"
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps "kolors@git+https://github.com/HochCC/Kolors.git"
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps "MoGe@git+https://github.com/microsoft/MoGe.git@a8c3734"

# ── 4. kaolin — pre-built wheel (было ~10 мин компиляции) ───────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
        https://nvidia-kaolin.s3.us-east-2.amazonaws.com/torch-2.4.0_cu118/kaolin-0.16.0-cp310-cp310-linux_x86_64.whl

# ── 5. pytorch3d — pre-built wheel (было ~15 мин компиляции) ────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
        https://dl.fbaipublicfiles.com/pytorch3d/packaging/wheels/py310_cu118_pyt240/pytorch3d-0.7.8-cp310-cp310-linux_x86_64.whl

# ── 6. gsplat — PyPI wheel (было ~8 мин компиляции) ─────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install gsplat==1.5.3

# ── 7. nvdiffrast — PyPI wheel ───────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "nvdiffrast@git+https://github.com/NVlabs/nvdiffrast.git@729261d"

# ── 8. diff-gaussian-rasterization — единственное что остаётся компилировать (~5 мин) ──
RUN git clone --recursive https://github.com/autonomousvision/mip-splatting.git /tmp/mip && \
    pip install /tmp/mip/submodules/diff-gaussian-rasterization && \
    rm -rf /tmp/mip

# ── 9. API ───────────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install fastapi==0.115.0 "uvicorn[standard]==0.30.0"

RUN mkdir -p /app/outputs/jobs /app/weights
