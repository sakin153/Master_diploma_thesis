# ─────────────────────────────────────────────────────────────────────
# Базовый образ — собирается ОДИН РАЗ.
# Пересобирать только при изменении зависимостей.
#
#   docker build -f Dockerfile.base -t embodiedgen-base:latest .
# ─────────────────────────────────────────────────────────────────────
# syntax=docker/dockerfile:1
FROM pytorch/pytorch:2.4.0-cuda11.8-cudnn9-devel

RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential ninja-build curl \
    libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV CUDA_HOME=/usr/local/cuda-11.8 \
    PATH=/usr/local/cuda-11.8/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda-11.8/lib64:$LD_LIBRARY_PATH \
    DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6" \
    TOKENIZERS_PARALLELISM=false \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ── 1. xformers ──────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install \
        xformers==0.0.27.post2 \
        --index-url https://download.pytorch.org/whl/cu118

# ── 2. requirements.txt ──────────────────────────────────────────────
COPY requirements.txt /tmp/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /tmp/requirements.txt --use-deprecated=legacy-resolver

# ── 3. Git-пакеты без колёс ──────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps "utils3d@git+https://github.com/EasternJournalist/utils3d.git@9a4eb15"
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "clip@git+https://github.com/openai/CLIP.git"
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "segment-anything@git+https://github.com/facebookresearch/segment-anything.git@dca509f"
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps "kolors@git+https://github.com/HochCC/Kolors.git"

# ── 4. kaolin — pre-built wheel ──────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    PY_TAG=$(python -c "import sys; print(f'cp{sys.version_info.major}{sys.version_info.minor}')") && \
    pip install \
        "https://nvidia-kaolin.s3.us-east-2.amazonaws.com/torch-2.4.0_cu118/kaolin-0.16.0-${PY_TAG}-${PY_TAG}-linux_x86_64.whl"

# ── 5. nvdiffrast ─────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "nvdiffrast@git+https://github.com/NVlabs/nvdiffrast.git@729261d"

# ── 6. API ───────────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install fastapi==0.115.0 "uvicorn[standard]==0.30.0"

# ── 7. Hunyuan3D-2 — клонируем и устанавливаем ───────────────────────
RUN git clone --depth=1 \
        https://github.com/Tencent-Hunyuan/Hunyuan3D-2 /opt/Hunyuan3D-2 && \
    pip install --no-cache-dir /opt/Hunyuan3D-2

# ── 8. Компилируем texture-расширения Hunyuan3D-2 ────────────────────
RUN cd /opt/Hunyuan3D-2/hy3dgen/texgen/custom_rasterizer && \
    python setup.py install
RUN cd /opt/Hunyuan3D-2/hy3dgen/texgen/differentiable_renderer && \
    python setup.py install

# ── 9. Пере-пинить transformers после Hunyuan3D ──────────────────────
RUN pip install "transformers==4.42.4"

RUN mkdir -p /app/outputs/jobs /app/weights
